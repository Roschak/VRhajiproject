@page "/"
@implements IAsyncDisposable
@inject ISceneService SceneService
@inject IProgressService ProgressService
@inject IJSRuntime JS

<PageTitle>Labbaik — Simulasi Haji</PageTitle>
<main class="game-hub">
    <div class="hub-atmosphere" aria-hidden="true"><div class="hub-orbit"></div><div class="hub-monument"><span></span></div></div>
        <header class="hub-header"><button class="hub-brand" @onclick="GoHome" disabled="@(!_ready)" aria-label="Kembali ke menu utama">LABBAIK<span>PERJALANAN HAJI</span></button><span class="hub-greeting">Assalamu’alaikum, <strong>@_prefs.Name</strong></span></header>
        <div class="hub-layout @(_menuOpen ? "hub-layout--page" : "hub-layout--landing")" data-ready="@(_ready ? "true" : "false")">
            <section class="hub-welcome" aria-hidden="@(_menuOpen ? "true" : "false")">
                <div class="hub-welcome-inner">
                    <span class="hub-eyebrow">PERJALANAN ANDA DIMULAI DI SINI</span>
                    <h1>Melangkah dengan<br /><em>niat yang baik.</em></h1>
                </div>
            </section>
            <nav class="hub-nav" aria-label="Menu utama">
                @foreach (var item in _navigation)
                {
                    <button class="@(_menuOpen && _tab == item.Key ? "active" : "")" aria-current="@(_menuOpen && _tab == item.Key ? "page" : null)" disabled="@(!_ready)" @onclick="() => SetTab(item.Key)"><span>@item.Number</span>@item.Label</button>
                }
                <div class="hub-nav-note">Satu perjalanan.<br />Langkah demi langkah.</div>
            </nav>
            <section class="hub-content" aria-label="@_tab" @key="_tab">
                @if (_tab == "home")
                {
                    @if (_menuOpen) { <span class="hub-eyebrow">PERJALANAN IBADAH</span><h1>Pilih perjalanan Anda.</h1> }
                    <p class="hub-lead">Pilih perjalanan ibadah. Setiap rangkaian berlangsung dalam satu dunia dan satu sesi VR yang berkelanjutan.</p>
                    <div class="hub-route-cards">
                        <article class="hub-route-card"><span>12 TAHAP · RUMAH HINGGA PULANG</span><h2>Perjalanan Haji</h2><p>Jeddah, Makkah, Arafah, Muzdalifah, dan Mina.</p><progress max="12" value="@_totalDone"></progress><a class="hub-primary" href="@(_highest > 0 && _highest < 12 ? $"/simulasi/haji?tahap={_highest + 1}" : "/simulasi/haji")">@(_highest > 0 && _highest < 12 ? "Lanjutkan Haji" : "Mulai perjalanan Haji") <span>↗</span></a></article>
                        <article class="hub-route-card"><span>6 TAHAP · RUMAH HINGGA PULANG</span><h2>Perjalanan Umrah</h2><p>Miqat, thawaf, shalat sunnah, sa’i, dan tahallul.</p><progress max="6" value="@_umrahDone"></progress><a class="hub-primary" href="@(_umrahDone > 0 && _umrahDone < 6 ? $"/simulasi/umrah?tahap={_umrahDone + 1}" : "/simulasi/umrah")">@(_umrahDone > 0 && _umrahDone < 6 ? "Lanjutkan Umrah" : "Mulai perjalanan Umrah") <span>↗</span></a></article>
                    </div>
                    <div class="hub-tiles"><button @onclick='() => SetTab("character")' disabled="@(!_ready)"><span>01 / KARAKTER</span><strong>Persiapkan diri</strong><small>Pilih karakter dan pakaian →</small></button><div><span>02 / ZIARAH</span><strong>Jelajahi sejarah</strong><small>Segera hadir</small></div></div>
                }
                else if (_tab == "character")
                {
                    <span class="hub-eyebrow">RUANG PERSIAPAN</span><h1>Karakter Anda</h1><p class="hub-lead">Putar model dengan menyeret. Gulir untuk mendekat.</p>
                    <div class="hub-editor">
                        <div class="hub-preview-wrap"><div id="character-preview" class="hub-preview"></div><div class="hub-animation"><button @onclick='() => Animate("idle")'>Diam</button><button @onclick='() => Animate("walk")'>Berjalan</button><button @onclick='() => Animate("run")'>Berlari</button></div></div>
                        <div class="hub-fields">
                            <label>Karakter<select aria-label="Karakter" @bind="_prefs.Gender" @bind:after="GenderChanged"><option value="man">Pria</option><option value="woman">Wanita</option></select></label>
                            <label>Pakaian<select aria-label="Pakaian" @bind="_prefs.Outfit" @bind:after="PreviewChanged">
                                <option value="robe">Gamis putih</option>
                                @if (_prefs.Gender == "man") { <option value="ihram">Kain ihram putih</option> }
                                else { <option value="abaya">Abaya &amp; khimar putih</option> }
                            </select></label>
                            <fieldset class="hub-skin"><legend>Warna kulit</legend><div class="hub-swatches">
                                @for (var i = 0; i < _skinTones.Length; i++) {
                                    var tone = _skinTones[i]; var label = $"Pilihan kulit {i + 1}";
                                    <button type="button" class="hub-swatch" style="--skin-tone: @tone" aria-label="@label" aria-pressed="@(_prefs.SkinTone == tone ? "true" : "false")" @onclick="() => SelectSkin(tone)"></button>
                                }
                            </div></fieldset>
                            <p class="hub-wardrobe-note">@(_prefs.Gender == "man" ? "Pratinjau ihram dapat dipilih di sini. Saat simulasi, pakaian mengikuti tahap ibadah dan rambut dicukur setelah tahallul." : "Seluruh pilihan dilengkapi hijab putih yang menutup rambut dan leher.")</p>
                            <button class="hub-primary" @onclick="Save">Simpan karakter <span>✓</span></button>
                            <small>Simpan untuk memakai karakter ini di simulasi.</small>
                        </div>
                    </div>
                }
                else if (_tab == "settings")
                {
                    <span class="hub-eyebrow">KENYAMANAN BERMAIN</span><h1>Pengaturan</h1><p class="hub-lead">Sesuaikan tampilan, suara, dan kontrol dengan perangkat Anda.</p>
                    <div class="hub-settings hub-fields">
                        <fieldset><legend>Tampilan</legend><label>Kualitas render<select @bind="_prefs.Resolution"><option value="0.5">Ringan · 50%</option><option value="0.75">Seimbang · 75%</option><option value="1">Tinggi · 100%</option></select></label><label class="hub-check"><input type="checkbox" @bind="_prefs.Shadows" />Bayangan dinamis</label><label>Batas FPS desktop<select @bind="_prefs.Fps"><option value="0">Mengikuti layar</option><option value="30">30 FPS</option><option value="60">60 FPS</option></select></label><small>VR mengikuti kecepatan refresh headset.</small></fieldset>
                        <fieldset><legend>Audio &amp; kontrol</legend><label>Volume efek · @((int)(_prefs.Volume * 100))%<input type="range" min="0" max="1" step="0.05" @bind="_prefs.Volume" /></label><label class="hub-check"><input type="checkbox" @bind="_prefs.Narration" />Panduan suara</label><label>Sensitivitas mouse · @_prefs.Sensitivity.ToString("0.00")<input type="range" min="0.25" max="2" step="0.05" @bind="_prefs.Sensitivity" /></label><label>Sudut putar VR<select @bind="_prefs.SnapAngle"><option value="15">15°</option><option value="30">30°</option><option value="45">45°</option></select></label></fieldset>
                    </div><button class="hub-primary" @onclick="Save">Simpan pengaturan <span>✓</span></button>
                }
                else if (_tab == "profile")
                {
                    <span class="hub-eyebrow">CATATAN PERJALANAN</span><h1>Profil jemaah</h1><div class="hub-profile hub-fields"><label>Nama panggilan<input maxlength="40" @bind="_prefs.Name" placeholder="Nama Anda" /></label><button class="hub-primary" @onclick="Save">Simpan profil <span>✓</span></button><small>Profil dan pilihan karakter tersimpan di browser perangkat ini.</small><div class="hub-trip"><span>PROGRES HAJI</span><strong>@_totalDone <small>/ 12 tahap selesai</small></strong><progress max="12" value="@_totalDone"></progress></div>
                    @if (_confirmReset) { <p>Hapus progres perjalanan pada perangkat ini?</p><button class="hub-secondary" @onclick="ResetProgress">Ya, ulangi perjalanan</button><button class="hub-secondary" @onclick="() => _confirmReset = false">Batal</button> }
                    else { <button class="hub-secondary" @onclick="() => _confirmReset = true">Ulangi progres perjalanan</button> }</div>
                }
                else if (_tab == "guide")
                {
                    <span class="hub-eyebrow">SEBELUM BERANGKAT</span><h1>Panduan bermain</h1><div class="hub-guide"><article><h2>Desktop</h2><p>WASD untuk berjalan. Seret mouse untuk melihat sekitar. Klik objek atau pilihan untuk berinteraksi. Ikuti penunjuk misi dan tekan Lanjutkan setelah tahap selesai.</p></article><article><h2>Headset VR</h2><p>Mulai simulasi lalu pilih Masuk VR. Thumbstick kiri untuk berjalan, kanan untuk berputar. Trigger untuk memilih dan grip untuk teleport dekat. Pergantian tahap tetap dalam sesi VR yang sama.</p></article><article><h2>Perjalanan haji</h2><p>Ikuti 12 tahap dari persiapan, perjalanan ke Arab Saudi, rangkaian ibadah, hingga pulang. Simulasi ini merupakan sarana latihan; panduan pembimbing tetap menjadi acuan ibadah Anda.</p></article></div>
                }
                @if (!string.IsNullOrEmpty(_message)) { <p class="hub-status" role="status">@_message</p> }
            </section>
        </div>
        <footer class="hub-footer"><span>LABBAIK / SIMULASI EDUKASI HAJI</span><span>Desktop &amp; WebXR</span></footer>
</main>

@code {
    private GamePreferences _prefs = new();
    private readonly string[] _skinTones = ["#f1cfb4", "#dca780", "#b9825b", "#956443", "#70462f", "#4b2f24"];
    private bool _menuOpen, _ready, _previewPending, _disposed, _confirmReset;
    private int _navigationVersion;
    private string _tab = "home", _message = "", _userId = "";
    private int _highest, _totalDone;
    private int _umrahDone;
    private IJSObjectReference? _userModule, _preferences, _preview;
    private readonly (string Key, string Number, string Label)[] _navigation = [("home", "01", "Perjalanan"), ("character", "02", "Karakter"), ("settings", "03", "Pengaturan"), ("profile", "04", "Profil"), ("guide", "05", "Panduan")];
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) {
            _userModule = await JS.InvokeAsync<IJSObjectReference>("import", "./js/user.js");
            _preferences = await JS.InvokeAsync<IJSObjectReference>("import", "./js/game-preferences.js");
            var journeyProgress = await JS.InvokeAsync<IJSObjectReference>("import", "./js/journey-progress.js");
            _umrahDone = await journeyProgress.InvokeAsync<int>("getCompleted", "umrah");
            await journeyProgress.DisposeAsync();
            _prefs = await _preferences.InvokeAsync<GamePreferences>("loadPreferences");
            _userId = await _userModule.InvokeAsync<string>("getUserId");
            await LoadProgress(); _ready = true;
            if (!_disposed) StateHasChanged();
        }
        if (_previewPending && !_disposed) {
            _previewPending = false;
            try {
                _preview ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/character-preview.js");
                if (_tab == "character" && !_disposed) await _preview.InvokeVoidAsync("mount", "character-preview", _prefs);
            } catch (JSException) { _message = "Pratinjau belum dapat dimuat. Buka kembali menu Karakter untuk mencoba lagi."; if (!_disposed) StateHasChanged(); }
        }
    }
    private Task GoHome() => SetTab("home", false);
    private async Task SetTab(string tab, bool openMenu = true) {
        if (!_ready || _disposed || (_tab == tab && _menuOpen == openMenu)) return;
        var version = ++_navigationVersion;
        if (_preview is not null) await _preview.InvokeVoidAsync("dispose");
        if (_disposed || version != _navigationVersion) return;
        _tab = tab; _menuOpen = openMenu; _message = ""; _previewPending = tab == "character";
    }
    private async Task GenderChanged() { _prefs.Outfit = "robe"; await PreviewChanged(); }
    private async Task SelectSkin(string tone) { _prefs.SkinTone = tone; await PreviewChanged(); }
    private async Task PreviewChanged() { if (_preview is not null) await _preview.InvokeVoidAsync("update", _prefs); }
    private async Task Animate(string name) { if (_preview is not null) await _preview.InvokeVoidAsync("animate", name); }
    private async Task Save() {
        if (_preferences is null) return;
        try { _prefs = await _preferences.InvokeAsync<GamePreferences>("savePreferences", _prefs); _message = "Pilihan Anda sudah disimpan."; }
        catch (JSException) { _message = "Penyimpanan browser tidak tersedia. Izinkan penyimpanan situs lalu coba lagi."; }
    }
    private async Task LoadProgress() {
        var scenes = await SceneService.GetAllScenesAsync();
        var progress = await ProgressService.GetProgressAsync(_userId);
        var ids = progress.Where(p => p.Completed && p.CheckpointId == 0).Select(p => p.SceneId).ToHashSet();
        var orders = scenes.Where(s => ids.Contains(s.Id)).Select(s => s.Urutan).ToHashSet();
        _highest = 0; while (orders.Contains(_highest + 1)) _highest++;
        _totalDone = orders.Count;
    }
    private async Task ResetProgress() { await ProgressService.ResetAsync(_userId); await LoadProgress(); _confirmReset = false; _message = "Progres perjalanan sudah diulang."; }
    public async ValueTask DisposeAsync() {
        _disposed = true;
        try {
            if (_preview is not null) { await _preview.InvokeVoidAsync("dispose"); await _preview.DisposeAsync(); }
            if (_preferences is not null) await _preferences.DisposeAsync();
            if (_userModule is not null) await _userModule.DisposeAsync();
        } catch (JSDisconnectedException) { }
    }
}
