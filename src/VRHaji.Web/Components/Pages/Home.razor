@page "/"
@inject ISceneService SceneService
@inject IProgressService ProgressService
@inject IJSRuntime JS

<PageTitle>VR Education Haji &amp; Umrah</PageTitle>

<div class="menu-root">
    @if (_showAnnouncement)
    {
        <div class="announcement-overlay">
            <div class="announcement-card">
                <div class="announcement-card__header">
                    <div class="announcement-card__icon">
                        <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/></svg>
                    </div>
                    <h2 class="announcement-card__title">Catatan Simulasi Edukasi</h2>
                </div>
                <div class="announcement-card__text">
                    Selamat datang di <strong>Simulasi VR Haji &amp; Umrah</strong>.<br/><br/>
                    Aplikasi ini dirancang sebagai sarana edukasi interaktif. Apabila terdapat perbedaan proporsi bangunan, tata letak area, maupun elemen visual lainnya jika dibandingkan dengan kondisi asli di lapangan, kami memohon maklum.<br/><br/>
                    Kami akan terus menyempurnakan pengalaman visual ini agar semakin mendekati kondisi nyata. Selamat belajar dan semoga bermanfaat.
                </div>
                <div class="announcement-card__footer">
                    <button class="btn btn--gold btn--big" @onclick="DismissAnnouncement">Mulai Simulasi ➜</button>
                </div>
            </div>
        </div>
    }

    <div class="menu-hero">
        <div class="menu-hero__emblem">
            <svg class="ui-icon" style="width:4.2rem;height:4.2rem;color:var(--c-gold-light);filter:drop-shadow(0 4px 16px rgba(74,222,128,0.25));" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zm0 8.5L4.5 7 12 3.25 19.5 7 12 10.5zM3 10.5v6.27l9 4.5 9-4.5V10.5l-9 4.5-9-4.5z"/></svg>
        </div>
        <h1 class="menu-hero__title">VR Education Haji &amp; Umrah</h1>
        <p class="menu-hero__subtitle">
            Simulasi interaktif rangkaian ibadah Haji dan Umrah — dari keberangkatan di Indonesia
            hingga Tawaf Wada' — dengan visual 3D imersif, narasi, dan validasi pemahaman.
        </p>
        @if (_totalDone > 0)
        {
            <div class="menu-hero__progress">
                <div class="menu-hero__progress-bar"><span style="width:@(_scenes.Count == 0 ? 0 : _totalDone * 100 / _scenes.Count)%"></span></div>
                <span class="menu-hero__progress-text">@_totalDone / @_scenes.Count scene selesai</span>
                <button class="btn btn--ghost btn--small" @onclick="ResetProgress">Ulangi dari awal</button>
            </div>
        }
    </div>

    <div class="menu-grid">
        @foreach (var scene in _scenes)
        {
            var unlocked = scene.Urutan <= _highest + 1;
            var done = _completedScenes.Contains(scene.Id);
            <div class="scene-card @(unlocked ? "" : "scene-card--locked") @(done ? "scene-card--done" : "")">
                <div class="scene-card__badge">
                    @if (done)
                    {
                        <svg class="ui-icon ui-icon--sm" viewBox="0 0 24 24"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/></svg>
                    }
                    else if (unlocked)
                    {
                        @scene.Urutan.ToString("00")
                    }
                    else
                    {
                        <svg class="ui-icon ui-icon--sm" viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
                    }
                </div>
                <div class="scene-card__body">
                    <div class="scene-card__eyebrow">Scene @scene.Urutan.ToString("00") · @scene.Lokasi</div>
                    <h3 class="scene-card__title">@scene.Nama</h3>
                    <p class="scene-card__desc">@scene.Deskripsi</p>
                </div>
                <div class="scene-card__footer">
                    <span class="scene-card__time">
                        <svg class="ui-icon ui-icon--sm" viewBox="0 0 24 24"><path d="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/></svg>
                        @scene.Waktu
                    </span>
                    @if (unlocked)
                    {
                        <a class="btn btn--gold" href="/scene/@scene.Urutan">
                            @(done ? "Ulangi" : "Mulai")
                            <svg class="ui-icon ui-icon--sm" viewBox="0 0 24 24"><path d="M5 13h11.86l-5.43 5.43 1.42 1.42L21.14 12l-8.29-7.85-1.42 1.42L16.86 11H5v2z"/></svg>
                        </a>
                    }
                    else
                    {
                        <span class="scene-card__lockmsg">Selesaikan scene sebelumnya</span>
                    }
                </div>
            </div>
        }
    </div>

    <footer class="menu-footer">
        Blazor Server (.NET 9) · Three.js WebGL 2.0 · Konten mengikuti dokumen protokol VR Education Haji &amp; Umrah v1.0
    </footer>
</div>

@code {
    private IReadOnlyList<SceneData> _scenes = [];
    private HashSet<int> _completedScenes = [];
    private int _highest;
    private int _totalDone;
    private string _userId = string.Empty;
    private IJSObjectReference? _userModule;
    private bool _showAnnouncement = false;

    protected override async Task OnInitializedAsync()
    {
        _scenes = await SceneService.GetAllScenesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var cacheBuster = DateTime.Now.Ticks;
        _userModule = await JS.InvokeAsync<IJSObjectReference>("import", $"./js/user.js?v={cacheBuster}");
        _userId = await _userModule.InvokeAsync<string>("getUserId");
        
        var hasSeen = await _userModule.InvokeAsync<bool>("hasSeenAnnouncement");
        if (!hasSeen)
        {
            _showAnnouncement = true;
        }

        await LoadProgressAsync();
        StateHasChanged();
    }

    private async Task LoadProgressAsync()
    {
        var progress = await ProgressService.GetProgressAsync(_userId);
        _completedScenes = progress.Where(p => p.Completed && p.CheckpointId == 0)
            .Select(p => p.SceneId).ToHashSet();
        var doneUrutan = _scenes.Where(s => _completedScenes.Contains(s.Id)).Select(s => s.Urutan).ToList();
        _highest = doneUrutan.Count == 0 ? 0 : doneUrutan.Max();
        _totalDone = doneUrutan.Count;
    }

    private async Task ResetProgress()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        await ProgressService.ResetAsync(_userId);
        await LoadProgressAsync();
    }

    private async Task DismissAnnouncement()
    {
        if (_userModule is not null)
        {
            await _userModule.InvokeVoidAsync("setAnnouncementSeen");
        }
        _showAnnouncement = false;
    }
}
