@page "/simulasi/haji"
@page "/simulasi/umrah"
@page "/scene/{Urutan:int}"
@inject ISceneService SceneService
@inject IProgressService ProgressService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@implements IAsyncDisposable

<PageTitle>Perjalanan @_routeLabel — VR Haji</PageTitle>

<div class="vr-root" id="vr-root">
    <div id="vr-container"></div>
    <div class="hud">
        <div class="hud__top">
            <div class="hud__scene-title">
                <span class="hud__scene-no">TAHAP @_current.ToString("00") / @_stageCount</span>
                <span>@_scene?.Nama</span>
            </div>
            <div class="hud__progress"><div id="vr-progressbar"></div></div>
            <div class="hud__top-right">
                <div id="vr-compass" class="hud__compass"><div id="vr-compass-dial">U</div></div>
                <button id="btn-enter-vr" class="btn btn--gold btn--small vr-enter-btn" hidden disabled>Masuk VR</button>
                @if (!_vrActive)
                {
                    <button class="btn btn--ghost btn--small" @onclick="ToggleMap">Rute perjalanan</button>
                    <a class="btn btn--ghost btn--small" href="/">Keluar ke menu</a>
                }
            </div>
        </div>
        <div id="vr-fallback-message" class="hud__vr-fallback" hidden></div>
        <div id="vr-objective" class="hud__objective"></div>
        <div id="vr-crosshair" class="hud__crosshair">+</div>
        <div id="vr-interact-label" class="hud__interact-label"></div>
        <div id="vr-subtitle" class="hud__subtitle"></div>
        <div id="vr-hint" class="hud__hint"></div>
        <canvas id="vr-minimap" class="hud__minimap" width="200" height="200"></canvas>
        <div id="vr-counter" class="hud__counter"></div>
    </div>

    @if (_showIntro)
    {
        <div class="overlay overlay--intro">
            <div class="intro-card">
                <div class="intro-card__no">PERJALANAN @_routeLabel.ToUpperInvariant()</div>
                <h1 class="intro-card__title">@_scene?.Nama</h1>
                <p class="intro-card__desc">Dari rumah hingga pulang kembali dalam satu sesi. Seluruh tahap berjalan pada halaman dan sesi VR yang sama.</p>
                <div class="intro-card__controls">
                    <p>Komputer: WASD untuk berjalan, tahan klik dan geser untuk melihat, klik objek untuk interaksi.</p>
                    <p>VR: thumbstick untuk berjalan, trigger untuk memilih. Arahkan controller ke lantai dan tekan grip untuk teleport dekat.</p>
                    <p>Tekan Lanjutkan saat tahap selesai. Jarak antarlokasi dan waktu perjalanan disingkat untuk latihan.</p>
                </div>
                @if (_error is not null)
                {
                    <p role="alert">@_error</p>
                    <a class="btn btn--ghost" href="/">Kembali ke menu</a>
                }
                else if (_loading)
                {
                    <div class="intro-card__loading">Menyiapkan dunia perjalanan…</div>
                }
                else
                {
                    <button class="btn btn--gold btn--big" @onclick="StartScene">Mulai Simulasi</button>
                }
            </div>
        </div>
    }

    @if (_showMap)
    {
        <div class="overlay overlay--panel">
            <div class="intro-card">
                <h2>Rute perjalanan</h2>
                @if (_route == "umrah")
                {
                    <p>Rumah → Bandara Indonesia → Madinah → Miqat Bir Ali → Makkah.</p>
                    <p>Ihram dari Miqat → Thawaf 7 putaran → Shalat Sunnah Thawaf 2 rakaat → Sa’i Safa–Marwah 7 perjalanan → Tahallul.</p>
                    <p>Makkah → Madinah → Indonesia → rumah.</p>
                }
                else
                {
                    <p>Rumah → Bandara Indonesia → Jeddah → hotel Makkah.</p>
                    <p>Ihram 8 Dzulhijjah → Arafah → Muzdalifah → Aqabah → Tahallul Awal → Thawaf Ifadhah &amp; Sa’i → Tahallul Tsani → Mina (11–13 Dzulhijjah, tiga jumrah) → Thawaf Wada’.</p>
                    <p>Makkah → Jeddah → Indonesia → rumah.</p>
                }
                <p>Peta menggunakan jarak yang dipadatkan untuk simulasi. Tahap aktif: @_current — @_scene?.Nama.</p>
                <button class="btn btn--gold" @onclick="ToggleMap">Tutup rute</button>
            </div>
        </div>
    }
    @if (_notification is not null)
    {
        <div class="toast toast--info">@_notification</div>
    }
</div>

@code {
    [Parameter] public int Urutan { get; set; }
    [SupplyParameterFromQuery(Name = "tahap")] public int? Tahap { get; set; }
    private int _current = 1;
    private int _stageCount = 12;
    private string _route = "haji";
    private string _routeLabel => _route == "umrah" ? "Umrah" : "Haji";
    private IJSObjectReference? _routeProgress;
    private SceneData? _scene;
    private bool _initialized, _showIntro = true, _loading = true, _showMap, _vrActive, _disposed;
    private string? _error, _notification;
    private string _userId = string.Empty;
    private IJSObjectReference? _module;
    private DotNetObjectReference<SceneView>? _selfRef;

    protected override async Task OnParametersSetAsync()
    {
        _route = Navigation.Uri.Contains("/simulasi/umrah", StringComparison.OrdinalIgnoreCase) ? "umrah" : "haji";
        _stageCount = _route == "umrah" ? 6 : 12;
        if (_initialized) return;
        _initialized = true;
        _current = Math.Clamp(Tahap ?? (Urutan == 0 ? 1 : Urutan), 1, _stageCount);
        await LoadScene(_current);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            await using var userModule = await JS.InvokeAsync<IJSObjectReference>("import", "/js/user.js");
            _userId = await userModule.InvokeAsync<string>("getUserId");
            _selfRef = DotNetObjectReference.Create(this);
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/vr/main.js");
            await _module.InvokeVoidAsync("preload", "vr-container", _current, _selfRef, _route);
            _loading = false;
        }
        catch (JSException)
        {
            _error = "Lingkungan 3D belum berhasil dimuat. Periksa dukungan WebGL dan koneksi, lalu buka kembali simulasi.";
        }
        if (!_disposed) StateHasChanged();
    }

    private async Task StartScene()
    {
        if (_loading || _module is null) return;
        _showIntro = false;
        await _module.InvokeVoidAsync("start");
    }

    private async Task ToggleMap()
    {
        _showMap = !_showMap;
        if (_module is not null) await _module.InvokeVoidAsync("setUiOpen", _showMap);
    }

    [JSInvokable] public Task OnNotify(string message, string type) => InvokeAsync(() =>
    {
        if (_disposed) return;
        _notification = message;
        StateHasChanged();
    });

    [JSInvokable] public Task OnVRSessionStarted() => InvokeAsync(async () =>
    {
        if (_disposed) return;
        _vrActive = true; _showMap = false;
        if (_module is not null) await _module.InvokeVoidAsync("setUiOpen", false);
        if (_showIntro) await StartScene();
        StateHasChanged();
    });

    [JSInvokable] public Task OnVRSessionEnded() => InvokeAsync(() =>
    {
        if (_disposed) return;
        _vrActive = false; StateHasChanged();
    });

    [JSInvokable] public async Task OnSceneCompleted(bool autoAdvance = true)
    {
        if (_disposed || _scene is null) return;
        if (_route == "umrah")
        {
            _routeProgress ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/journey-progress.js");
            await _routeProgress.InvokeVoidAsync("saveCompleted", _route, _current);
        }
        else if (_scene.Id > 0) await ProgressService.SaveCheckpointAsync(_userId, _scene.Id, 0, 100);
    }

    [JSInvokable] public Task OnSceneHotSwapped(int index) => InvokeAsync(async () =>
    {
        if (_disposed) return;
        _current = index;
        await LoadScene(index);
        StateHasChanged();
    });

    private async Task LoadScene(int index)
    {
        var data = await SceneService.GetSceneByUrutanAsync(Math.Min(index, 12));
        _scene = new SceneData { Id = _route == "haji" ? data?.Id ?? 0 : 0, Urutan = index,
            Nama = _route == "umrah" ? UmrahTitles[index - 1] : HajjTitles[index - 1],
            Deskripsi = data?.Deskripsi ?? string.Empty, Lokasi = data?.Lokasi ?? string.Empty,
            Waktu = data?.Waktu ?? string.Empty, ConfigJson = data?.ConfigJson ?? "{}", EdukasiJson = data?.EdukasiJson ?? "{}" };
    }

    private static readonly string[] HajjTitles = ["Berangkat dari rumah ke Bandara Indonesia", "Tiba di Jeddah dan menuju hotel Makkah", "Ihram Haji - 8 Dzulhijjah dari hotel Makkah", "Wukuf di Arafah - 9 Dzulhijjah", "Mabit dan mengambil kerikil di Muzdalifah", "Lempar Jumrah Aqabah - 10 Dzulhijjah", "Tahallul Awal di Mina", "Thawaf Ifadhah dan Sa’i Haji", "Tahallul Tsani", "Mabit di Mina dan lempar 3 Jumrah", "Thawaf Wada’", "Perjalanan pulang ke Indonesia"];
    private static readonly string[] UmrahTitles = ["Ihram dari Miqat - niat dan pakaian ihram", "Thawaf Umrah - tujuh putaran", "Shalat Sunnah Thawaf - dua rakaat", "Sa’i Umrah - tujuh perjalanan Safa-Marwah", "Tahallul Umrah - memotong atau mencukur rambut", "Perjalanan pulang setelah Umrah"];

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            if (_routeProgress is not null) await _routeProgress.DisposeAsync();
        }
        catch (JSDisconnectedException) { }
        _selfRef?.Dispose();
    }
}
